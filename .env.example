# ============================================
# KetoPlanner - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# --- LLM API Configuration ---
# Choose your provider: "openai" (default), "deepseek", or "anthropic"
LLM_PROVIDER=openai

# API Key (works for OpenAI or DeepSeek)
# For OpenAI: sk-proj-...
# For DeepSeek: sk-...
LLM_API_KEY=

# OpenAI Configuration (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# DeepSeek Configuration (used when LLM_PROVIDER=deepseek)
# DeepSeek is MUCH cheaper than OpenAI (~1/20th the cost)
# Get a key at: https://platform.deepseek.com/api_keys
# DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# Anthropic Configuration (used when LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# --- Server Configuration ---
PORT=3001
NODE_ENV=development

# --- CORS ---
# In production, set this to your actual domain
CORS_ORIGIN=*

# --- Frontend Configuration (for separate deployments) ---
# Leave blank if backend serves the frontend (recommended)
# Set to full backend URL if frontend is deployed separately (e.g., Vercel)
VITE_API_URL=

# --- Rate Limiting ---
RATE_LIMIT_MAX=20
